{
  "meta": {
    "name": "自媒体专项检测",
    "description": "公众号/自媒体场景：在通用规则基础上，额外检测书面语过重、段落过长等问题。自媒体可以口语化，但要自然不是AI味",
    "version": "1.0.0"
  },
  "rules": [
    {
      "id": "S01",
      "name": "书面语过重",
      "category": "语体不匹配",
      "severity": "medium",
      "patterns": [
        "笔者认为",
        "笔者注意到",
        "笔者发现",
        "经笔者",
        "由笔者",
        "本文将",
        "本文旨在",
        "本文探讨",
        "如下所述",
        "如上所述",
        "前文所述",
        "后文将",
        "鉴于此",
        "有鉴于此",
        "故而",
        "然则",
        "诚然",
        "固然",
        "毋庸讳言",
        "毋庸置疑"
      ],
      "suggestion": "自媒体不需要书面语腔。'笔者认为'改'我觉得'，'本文将'直接删掉开头说事"
    },
    {
      "id": "S02",
      "name": "段落过长",
      "category": "排版",
      "severity": "low",
      "patterns": [],
      "custom_check": "long_paragraph",
      "threshold": {
        "char_count": 200
      },
      "suggestion": "段落超200字=手机阅读体验差。建议在观点切换处断段"
    },
    {
      "id": "S03",
      "name": "万能转折堆叠",
      "category": "AI句式",
      "severity": "medium",
      "patterns": [
        "然而.{0,20}但是",
        "虽然.{0,30}但是.{0,30}不过",
        "不过.{0,20}然而",
        "但是.{0,30}不过.{0,30}然而"
      ],
      "suggestion": "一段话里多个转折词堆叠=AI在'辩证'。保留一个转折，其余删掉"
    },
    {
      "id": "S04",
      "name": "总结句模板",
      "category": "结构套话",
      "severity": "medium",
      "patterns": [
        "总而言之",
        "总的来说",
        "综上所述",
        "归根结底",
        "说到底",
        "归根到底",
        "一言以蔽之",
        "简而言之"
      ],
      "suggestion": "结尾总结句=AI收尾模板。直接用最后一句话收尾，不需要总结词"
    }
  ]
}