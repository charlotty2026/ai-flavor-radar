{
  "meta": {
    "name": "通用AI味检测",
    "description": "两个场景共用的AI味规则：起承转合套话、AI自我暴露、万能助词、对仗招牌句式、清单符号陷阱",
    "version": "1.0.0"
  },
  "rules": [
    {
      "id": "C01",
      "name": "起承转合套话",
      "category": "结构套话",
      "severity": "high",
      "patterns": [
        "值得注意的是",
        "不可忽视的是",
        "不可否认的是",
        "不容忽视的是",
        "不言而喻",
        "毋庸置疑",
        "众所周知",
        "综上所述",
        "总而言之",
        "由此可见",
        "由此可见一斑",
        "值得一提的是",
        "需要指出的是",
        "需要强调的是",
        "首先.{0,20}其次.{0,20}最后",
        "一方面.{0,30}另一方面"
      ],
      "suggestion": "删除套话，直接说结论。读者不需要被引导"
    },
    {
      "id": "C02",
      "name": "AI自我暴露",
      "category": "身份泄露",
      "severity": "fatal",
      "patterns": [
        "作为AI",
        "作为人工智能",
        "我是AI",
        "作为一个AI",
        "我建议您",
        "我无法",
        "我不能",
        "我理解您的",
        "根据我的理解",
        "基于以上分析",
        "通过以上分析",
        "经过分析",
        "经过深入分析"
      ],
      "suggestion": "删除AI身份暗示，改为事实陈述"
    },
    {
      "id": "C03",
      "name": "万能助词",
      "category": "空洞词汇",
      "severity": "medium",
      "patterns": [
        "赋能",
        "闭环",
        "抓手",
        "底层逻辑",
        "顶层设计",
        "生态系统",
        "生态闭环",
        "降维打击",
        "赛道",
        "打法",
        "心智",
        "颗粒度",
        "对齐",
        "拉齐",
        "沉淀",
        "复用",
        "链路",
        "触达",
        "心智模型",
        "范式",
        "范式转移"
      ],
      "suggestion": "替换为具体动作或删除。用'帮助'替代'赋能'，用'流程'替代'闭环'"
    },
    {
      "id": "C04",
      "name": "对仗AI招牌句式",
      "category": "AI句式",
      "severity": "high",
      "patterns": [
        "不仅.{1,15}更",
        "不仅.{1,15}而且",
        "既.{1,10}又.{1,10}",
        "X而非Y",
        "适合.{1,15}不适合",
        "X强但Y大",
        "不是.{1,15}而是",
        "与其.{1,15}不如",
        "从.{1,10}到.{1,10}的"
      ],
      "suggestion": "对仗句式是AI最高频模板。拆成两个独立短句，去掉'不仅/既/不是...而是'的框架"
    },
    {
      "id": "C05",
      "name": "清单符号跨段重复",
      "category": "排版模板",
      "severity": "medium",
      "patterns": [
        "①②③④⑤",
        "（1）（2）（3）",
        "第一.{0,5}第二.{0,5}第三",
        "首先.{0,5}其次.{0,5}再次"
      ],
      "suggestion": "同一篇文章内清单符号重复使用超2次=平台一眼模板。打散为自然段落或换编号方式"
    }
  ]
}